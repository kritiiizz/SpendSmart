{
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "SpendSmart",
    "Audience": "SpendSmart.Api",
    "SigningKey": "",
    "ExpiryMinutes": 60
  },
  "Seed": {
    "Enabled": true,
    "DemoEmail": "demo@spendsmart.dev",
    "DemoPassword": "Demo1234!"
  },
  "RecurringExpenses": {
    "Enabled": true,
    "Interval": "01:00:00"
  },
  "RateLimiting": {
    "AuthPermitsPerMinute": 10
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ]
  },
  "AllowedHosts": "*"
}
