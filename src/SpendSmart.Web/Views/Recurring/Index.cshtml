@model RecurringListViewModel
@{
    ViewData["Title"] = "Recurring expenses";
}
<div class="d-flex justify-content-between align-items-center mb-1">
    <h1 class="h3 mb-0">Recurring expenses</h1>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add recurring</a>
</div>
<p class="text-muted">Rent, subscriptions and other regular payments. A background job adds them to your expenses when they're due.</p>

@if (Model.Items.Count == 0)
{
    <div class="card p-5 text-center text-muted">
        <i class="bi bi-arrow-repeat" style="font-size: 2.5rem"></i>
        <p class="mt-2 mb-3">Nothing recurring yet.</p>
        <div><a asp-action="Create" class="btn btn-primary">Add rent or a subscription</a></div>
    </div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Description</th>
                        <th>Category</th>
                        <th>Frequency</th>
                        <th>Next payment</th>
                        <th class="text-end">Amount</th>
                        <th class="text-end"><span class="visually-hidden">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        <tr class="@(r.IsActive ? "" : "text-muted")">
                            <td>
                                @r.Description
                                @if (!r.IsActive)
                                {
                                    <span class="badge text-bg-secondary ms-1">Paused</span>
                                }
                            </td>
                            <td>@r.CategoryName</td>
                            <td>@r.Frequency</td>
                            <td>@(r.IsActive ? r.NextOccurrence.ToString("dd MMM yyyy", CultureInfo.InvariantCulture) : "–")</td>
                            <td class="text-end amount">@r.Amount.ToMoney()</td>
                            <td class="text-end text-nowrap">
                                <form asp-action="@(r.IsActive ? "Pause" : "Resume")" asp-route-id="@r.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(r.IsActive ? "Pause" : "Resume")">
                                        <i class="bi @(r.IsActive ? "bi-pause" : "bi-play")"></i>
                                    </button>
                                </form>
                                @await Html.PartialAsync("_ConfirmDelete", ("Recurring", r.Id, "this recurring expense"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
